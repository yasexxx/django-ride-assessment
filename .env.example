# Copy to .env and adjust. docker-compose reads this file.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / PostGIS
POSTGRES_DB=rides
POSTGRES_USER=rides
POSTGRES_PASSWORD=rides
POSTGRES_HOST=db
POSTGRES_PORT=5432
